{
  "manifest_version": 3,
  "name": "Primus",
  "description": "A zkTLS-powered tool for verifying website data and actions with privacy.",
  "background": { "service_worker": "background.bundle.js" },
  "action": {
    "default_icon": "logo.png"
  },
  "icons": {
    "128": "logo.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "offscreen",
    "webRequest",
    "scripting",
    "alarms"
  ],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": [
        "iconPado.svg",
        "iconPrimusSquare.svg"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["padoZKAttestationJSSDK.bundle.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["primus.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://dev.primuslabs.xyz/*"
      ],
      "js": ["devconsole.bundle.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://twitter.com/intent/follow?screen_name=*",
        "https://x.com/intent/follow?screen_name=*",
        "https://x.com/intent/retweet?tweet_id=*"
      ],
      "js": ["xPage.bundle.js"]
    },
    {
      "matches": [
        "http://app.primuslabs.xyz/*",
        "https://app.primuslabs.xyz/*",
        "http://points.primuslabs.xyz/*",
        "https://points.primuslabs.xyz/*",
        "http://pay.primuslabs.xyz/*",
        "https://pay.primuslabs.xyz/*",
        "https://luckydraw.primuslabs.xyz/*"
      ],
      "js": ["xEvent.bundle.js"]
    }
  ]
}
